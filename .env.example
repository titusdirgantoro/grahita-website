# Salin ke .env lalu sesuaikan: cp .env.example .env
#
# TIDAK ADA rahasia produksi di berkas ini. Nilai di bawah hanya contoh untuk
# pengembangan lokal (Docker Compose). Rahasia produksi diberikan lewat
# environment server / SOPS+age dan tidak pernah masuk repo.

## ---------- umum ----------
APP_ENV=local
LOG_LEVEL=debug
HTTP_ADDR=:8080

## ---------- database ----------
POSTGRES_USER=grahita
POSTGRES_PASSWORD=grahita
POSTGRES_DB=grahita
POSTGRES_PORT=5433          # port di host; 5433 agar tidak bentrok dengan Postgres lokal

## ---------- domain portal (keputusan user — jangan diubah) ----------
CUSTOMER_HOST=grahita-branch.tiusclaw.com
ADMIN_HOST=grahita-admin.tiusclaw.com
PUBLIC_SCHEME=https

## ---------- sesi & keamanan ----------
SESSION_COOKIE_NAME=grahita_session
# Dikosongkan agar mengikuti APP_ENV (true kecuali local).
# SESSION_SECURE=true
SESSION_IDLE=8h
SESSION_ABSOLUTE=720h
CSRF_ENABLED=true
# Rute halaman atur ulang kata sandi pada tiap portal (tautan email
# `${PORTAL}/lupa?token=...`).
PASSWORD_RESET_PATH=/lupa
# Hanya diisi bila mengembangkan dengan Vite dev server di port lain.
CORS_ORIGINS=

# Fixture sesi browser sintetis. WAJIB tetap false di production. Saat aktif,
# password internal hanya dibaca proses API dan tidak pernah dikirim browser.
# Gunakan scripts/browser-fixture-local.sh agar password acak tidak tercetak.
BROWSER_FIXTURE_ENABLED=false
BROWSER_FIXTURE_PASSWORD=
BROWSER_FIXTURE_SUPERADMIN_EMAIL=rina@grahitaindonesia.com
BROWSER_FIXTURE_MANAGER_EMAIL=budi@grahitaindonesia.com
BROWSER_FIXTURE_BRANCH_EMAIL=bandung@grahitaindonesia.com

## ---------- object storage (MinIO saat lokal) ----------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=grahita
S3_ACCESS_KEY=grahita
S3_SECRET_KEY=grahita123
S3_USE_PATH_STYLE=true

# AES-256 base64 untuk before-snapshot rollback impor master staging.
# Buat nilai lokal/operator dengan: openssl rand -base64 32
MASTER_IMPORT_SNAPSHOT_KEY=

## ---------- email ----------
# Pengiriman email selalu lewat tabel email_outbox; worker (mode --mode=worker)
# yang memindai dan mengirimnya. Tanpa SMTP_HOST, email hanya dicatat di log.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@grahita.id
# MAIL_FROM adalah alamat pengirim (bawaan no-reply@grahita.id). Untuk
# integrasi, isi lewat environment dengan alamat akun pengelola
# (mis. nama@contoh.id) — konfigurasi pengirim tidak pernah ditulis di repo.
# Batas waktu TOTAL satu operasi kirim, supaya peer SMTP yang diam tidak
# menggantung worker (default 30s).
SMTP_TIMEOUT=30s
# Jeda pemindaian outbox oleh worker, jumlah percobaan KIRIM maksimum per email
# (1 percobaan pertama + 5 percobaan ulang berjenjang 1m/5m/30m/2j/6j, PRD
# EM-01), dan jumlah email maksimum per pemindaian.
OUTBOX_INTERVAL=1m
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_BATCH=50
# Jam (WIB) pekerjaan pengingat pembayaran Cash & Carry dijalankan setiap hari
# (F2-23). Pengingat dikirim ke email cabang pada H-2, H-0, H+1, dan H+3 relatif
# jatuh tempo; tiap tahap hanya sekali.
REMINDER_JAM_WIB=7

## ---------- dokumen ----------
GOTENBERG_URL=http://gotenberg:3000

## ---------- cadangan terenkripsi (F1-21, Architecture.md §7) ----------
# Tujuan: kosongkan keduanya di lokal supaya tidak ada pekerjaan cadangan
# berjalan. Cadangan berjalan 02:00 WIB dari worker (--mode=worker).
#   BACKUP_TARGET=dir     → BACKUP_TARGET_DIR=/var/backups/grahita
#   BACKUP_TARGET=rclone  → BACKUP_RCLONE_REMOTE=gdrive:grahita-backup
BACKUP_TARGET=
BACKUP_TARGET_DIR=
BACKUP_RCLONE_BIN=rclone
BACKUP_RCLONE_REMOTE=
# Berkas konfigurasi rclone MILIK OPERATOR (di luar repo, mis. /etc/rclone/rclone.conf).
BACKUP_RCLONE_CONFIG=
# Kunci publik age boleh ada di environment; kunci privat HANYA sebagai berkas
# milik operator (jangan pernah dikomit):
#   age-keygen -o /etc/grahita/backup-identitas.txt
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=
BACKUP_PG_DUMP=pg_dump
BACKUP_PG_RESTORE=pg_restore
BACKUP_WORK_DIR=/tmp/grahita-backup
BACKUP_RETENSI_HARIAN=30
BACKUP_RETENSI_BULANAN=12
BACKUP_WAL_HARI=7
# Arsip WAL untuk PITR (kosong = PITR tidak aktif; lihat infra/backup/README.md).
BACKUP_WAL_DIR=
BACKUP_JAM_WIB=2
BACKUP_INTERVAL=15m
# Sapu objek yatim documents/ HANYA bisa dipersenjatai lewat flag CLI eksplisit
# (`--mode=backup-rekonsiliasi --sweep`); tidak ada variabel lingkungan untuk itu.
BACKUP_SWEEP_GRACE=24h
# Database uji untuk restore kuartalan (nama harus dikenali sebagai uji/staging).
BACKUP_RESTORE_DSN=

## ---------- worker ----------
WORKER_INTERVAL=15s
WORKER_CONCURRENCY=4
# Listener /metrics proses worker (Architecture.md §8). Tidak dipublikasikan ke
# host; hanya Prometheus di jaringan Compose yang menjangkaunya.
WORKER_METRICS_ADDR=:9091

## ---------- observability (Architecture.md §8) ----------
# Endpoint /metrics API. Caddy TIDAK mem-proxy /metrics dan port API tidak
# dipublikasikan di produksi, jadi hanya Prometheus internal yang bisa memanen.
METRICS_ENABLED=true
METRICS_INTERVAL=30s
# Titik mount yang rasionya dipantau (alert disk > 80%).
DISK_MOUNTS=/
# Sentry: kosong = pelaporan dimatikan (no-op). DSN adalah RAHASIA — jangan
# dikomit; isi lewat mekanisme rahasia operator.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

## ---------- pembacaan bukti AI/OCR (kartu F2-26) ----------
# Provider di balik interface PaymentReader:
#   claude (bawaan) -> Claude API vision; mock -> pembaca deterministik
#   untuk pengembangan/pengujian (TIDAK menyetujui pembayaran atas dasar
#   angka karangan: bawaannya "tidak terbaca").
OCR_PROVIDER=claude
# Kunci Claude API. Kosong berarti pekerjaan pembacaan bukti GAGAL dan diulang
# sampai diisi (admin tetap bisa memverifikasi manual); kunci tidak pernah
# dicatat ke log maupun entri audit.
ANTHROPIC_API_KEY=
# Endpoint & model vision (kosong = bawaan: api.anthropic.com + model bawaan).
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# Batas waktu satu panggilan provider.
OCR_TIMEOUT=60s

## ---------- observability stack (overlay docker-compose.observability.yml) ----------
# Kata sandi Grafana WAJIB diisi; tidak ada nilai bawaan.
GRAFANA_PASSWORD=
GRAFANA_USER=admin
PROMETHEUS_RETENSI=30d
# Kontak & kredensial pengiriman alarm (dari environment, bukan repo).
ALERT_EMAIL_TO=
ALERT_SMTP_SMARTHOST=smtp.gmail.com:587
ALERT_SMTP_FROM=
ALERT_SMTP_USER=
ALERT_SMTP_PASS=

## ---------- rilis (overlay staging/produksi) ----------
# Image dari GHCR (di-tag commit SHA oleh .github/workflows/release.yml).
IMAGE_PREFIX=ghcr.io/grahita/portal
IMAGE_TAG=latest
# Basic-auth staging: hash bcrypt dari `caddy hash-password`, bukan teks biasa.
STAGING_HOST=staging.grahita-branch.tiusclaw.com
STAGING_ADMIN_HOST=staging.grahita-admin.tiusclaw.com
STAGING_BASIC_AUTH_USER=grahita
STAGING_BASIC_AUTH_HASH=
ACME_EMAIL=admin@grahitaindonesia.com

## ---------- seed pengembangan ----------
# Hanya diisi saat menjalankan `make seed`; tidak pernah dikomit.
SEED_PASSWORD=
