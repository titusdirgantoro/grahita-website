# Salin ke .env lalu sesuaikan: cp .env.example .env
#
# TIDAK ADA rahasia produksi di berkas ini. Nilai di bawah hanya contoh untuk
# pengembangan lokal (Docker Compose). Rahasia produksi diberikan lewat
# environment server / SOPS+age dan tidak pernah masuk repo.

## ---------- umum ----------
APP_ENV=local
LOG_LEVEL=debug
HTTP_ADDR=:8080

## ---------- database ----------
POSTGRES_USER=grahita
POSTGRES_PASSWORD=grahita
POSTGRES_DB=grahita
POSTGRES_PORT=5433          # port di host; 5433 agar tidak bentrok dengan Postgres lokal

## ---------- domain portal (keputusan user — jangan diubah) ----------
CUSTOMER_HOST=grahita-branch.tiusclaw.com
ADMIN_HOST=grahita-admin.tiusclaw.com
PUBLIC_SCHEME=https

## ---------- sesi & keamanan ----------
SESSION_COOKIE_NAME=grahita_session
# Dikosongkan agar mengikuti APP_ENV (true kecuali local).
# SESSION_SECURE=true
SESSION_IDLE=8h
SESSION_ABSOLUTE=720h
CSRF_ENABLED=true
# Hanya diisi bila mengembangkan dengan Vite dev server di port lain.
CORS_ORIGINS=

## ---------- object storage (MinIO saat lokal) ----------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=grahita
S3_ACCESS_KEY=grahita
S3_SECRET_KEY=grahita123
S3_USE_PATH_STYLE=true

## ---------- email ----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@grahita.id

## ---------- dokumen ----------
GOTENBERG_URL=http://gotenberg:3000

## ---------- worker ----------
WORKER_INTERVAL=15s
WORKER_CONCURRENCY=4

## ---------- seed pengembangan ----------
# Hanya diisi saat menjalankan `make seed`; tidak pernah dikomit.
SEED_PASSWORD=
