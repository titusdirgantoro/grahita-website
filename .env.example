# Salin ke .env lalu sesuaikan: cp .env.example .env
#
# TIDAK ADA rahasia produksi di berkas ini. Nilai di bawah hanya contoh untuk
# pengembangan lokal (Docker Compose). Rahasia produksi diberikan lewat
# environment server / SOPS+age dan tidak pernah masuk repo.

## ---------- umum ----------
APP_ENV=local
LOG_LEVEL=debug
HTTP_ADDR=:8080

## ---------- database ----------
POSTGRES_USER=grahita
POSTGRES_PASSWORD=grahita
POSTGRES_DB=grahita
POSTGRES_PORT=5433          # port di host; 5433 agar tidak bentrok dengan Postgres lokal

## ---------- domain portal (keputusan user — jangan diubah) ----------
CUSTOMER_HOST=grahita-branch.tiusclaw.com
ADMIN_HOST=grahita-admin.tiusclaw.com
PUBLIC_SCHEME=https

## ---------- sesi & keamanan ----------
SESSION_COOKIE_NAME=grahita_session
# Dikosongkan agar mengikuti APP_ENV (true kecuali local).
# SESSION_SECURE=true
SESSION_IDLE=8h
SESSION_ABSOLUTE=720h
CSRF_ENABLED=true
# Rute halaman atur ulang kata sandi pada tiap portal (tautan email
# `${PORTAL}/lupa?token=...`).
PASSWORD_RESET_PATH=/lupa
# Hanya diisi bila mengembangkan dengan Vite dev server di port lain.
CORS_ORIGINS=

## ---------- object storage (MinIO saat lokal) ----------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=grahita
S3_ACCESS_KEY=grahita
S3_SECRET_KEY=grahita123
S3_USE_PATH_STYLE=true

## ---------- email ----------
# Pengiriman email selalu lewat tabel email_outbox; worker (mode --mode=worker)
# yang memindai dan mengirimnya. Tanpa SMTP_HOST, email hanya dicatat di log.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@grahita.id
# Batas waktu TOTAL satu operasi kirim, supaya peer SMTP yang diam tidak
# menggantung worker (default 30s).
SMTP_TIMEOUT=30s
# Jeda pemindaian outbox oleh worker, jumlah percobaan KIRIM maksimum per email
# (1 percobaan pertama + 5 percobaan ulang berjenjang 1m/5m/30m/2j/6j, PRD
# EM-01), dan jumlah email maksimum per pemindaian.
OUTBOX_INTERVAL=1m
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_BATCH=50

## ---------- dokumen ----------
GOTENBERG_URL=http://gotenberg:3000

## ---------- cadangan terenkripsi (F1-21, Architecture.md §7) ----------
# Tujuan: kosongkan keduanya di lokal supaya tidak ada pekerjaan cadangan
# berjalan. Cadangan berjalan 02:00 WIB dari worker (--mode=worker).
#   BACKUP_TARGET=dir     → BACKUP_TARGET_DIR=/var/backups/grahita
#   BACKUP_TARGET=rclone  → BACKUP_RCLONE_REMOTE=gdrive:grahita-backup
BACKUP_TARGET=
BACKUP_TARGET_DIR=
BACKUP_RCLONE_BIN=rclone
BACKUP_RCLONE_REMOTE=
# Berkas konfigurasi rclone MILIK OPERATOR (di luar repo, mis. /etc/rclone/rclone.conf).
BACKUP_RCLONE_CONFIG=
# Kunci publik age boleh ada di environment; kunci privat HANYA sebagai berkas
# milik operator (jangan pernah dikomit):
#   age-keygen -o /etc/grahita/backup-identitas.txt
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=
BACKUP_PG_DUMP=pg_dump
BACKUP_PG_RESTORE=pg_restore
BACKUP_WORK_DIR=/tmp/grahita-backup
BACKUP_RETENSI_HARIAN=30
BACKUP_RETENSI_BULANAN=12
BACKUP_WAL_HARI=7
# Arsip WAL untuk PITR (kosong = PITR tidak aktif; lihat infra/backup/README.md).
BACKUP_WAL_DIR=
BACKUP_JAM_WIB=2
BACKUP_INTERVAL=15m
# Sapu objek yatim documents/ HANYA bisa dipersenjatai lewat flag CLI eksplisit
# (`--mode=backup-rekonsiliasi --sweep`); tidak ada variabel lingkungan untuk itu.
BACKUP_SWEEP_GRACE=24h
# Database uji untuk restore kuartalan (nama harus dikenali sebagai uji/staging).
BACKUP_RESTORE_DSN=

## ---------- worker ----------
WORKER_INTERVAL=15s
WORKER_CONCURRENCY=4

## ---------- seed pengembangan ----------
# Hanya diisi saat menjalankan `make seed`; tidak pernah dikomit.
SEED_PASSWORD=
