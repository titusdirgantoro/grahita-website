# Konfigurasi Caddy untuk produksi (dipakai docker-compose.prod.yml).
#
# Domain keputusan user (jangan diubah tanpa persetujuan):
#   customer -> grahita-branch.tiusclaw.com
#   admin    -> grahita-admin.tiusclaw.com
#
# Rute admin berada di ROOT host admin (bukan /admin seperti dokumen lama).
# Endpoint API tetap /api/v1/admin dan selalu dilayani API same-origin di host
# masing-masing, sehingga browser tidak pernah melakukan request lintas-origin.

{
	email admin@grahitaindonesia.com
}

{$CUSTOMER_HOST:grahita-branch.tiusclaw.com} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv/customer
		try_files {path} /index.html
		file_server
	}
}

{$ADMIN_HOST:grahita-admin.tiusclaw.com} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
